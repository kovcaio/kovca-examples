# Shell variables for a live call. Leave them empty in git.

# Run access. This program does not post to Slack itself.
KOVCA_API_KEY=
KOVCA_WORKFLOW_ID=

# Optional. When set, messages from any other channel are not forwarded.
# SLACK_CHANNEL_ID=C08SUPPORT1

# Required only for --delivery, which verifies X-Slack-Signature.
# SLACK_SIGNING_SECRET=

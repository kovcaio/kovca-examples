# Shell variables for a live call. Leave them empty in git.

# Run access. This program does not publish or edit the workflow.
KOVCA_API_KEY=
KOVCA_WORKFLOW_ID=

# Optional. When set, deliveries for any other repository are refused.
# GITHUB_REPOSITORY=acme/storefront

# Required only for --delivery, which verifies X-Hub-Signature-256.
# GITHUB_WEBHOOK_SECRET=

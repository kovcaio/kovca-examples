# Copy the variables you need into your shell. Do not commit a filled-in .env.
# Workspace keys start with kvc_. Instant workflow keys (kvt_) do not call the API or MCP.

# Run access is enough to execute a published workflow and read run metadata.
KOVCA_API_KEY=

# Publish access is required only to answer an approval over the API.
KOVCA_PUBLISH_API_KEY=

# Published workflow id from the Studio, such as the id shown after Publish.
KOVCA_WORKFLOW_ID=

# Optional pin. Omit it to run the latest published version.
# KOVCA_WORKFLOW_VERSION=1

# Optional. The default is https://kovca.io
# KOVCA_ORIGIN=https://kovca.io
